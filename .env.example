# outreach-os configuration. Copy to .env for local development. Never commit .env.

# ---- Deployment
# Signs sessions and encrypts the API keys workspaces store. Required in production.
SECRET_KEY=
# Postgres URL in production (Neon, Supabase, RDS...). Empty: local SQLite under ./data.
DATABASE_URL=
# Public URL of the app, used in unsubscribe links.
PUBLIC_BASE_URL=http://localhost:8000
# Protects /api/cron/tick (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# ---- Optional fallback keys, used by any workspace that has not set its own in Settings
GEMINI_API_KEY=
HUNTER_API_KEY=
RESEND_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- Command-line pipeline (python -m outreach run domains.txt)
OWNER_EMAIL=
GEMINI_MODEL_SMART=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
HUNTER_MONTHLY_BUDGET=25
RESEND_FROM=onboarding@resend.dev
SKELETON_DOMAIN=
